<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup" android:textAppearance="?attr/textAppearanceBodyLarge" android:textColor="?attr/colorOnSurfaceVariant" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/source_heading" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorPrimary" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/profile_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/source_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="textCapWords" android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/account_heading" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorPrimary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/vector_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/connect_vector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/connect_vector" style="@style/Widget.SaoSource.Chip.Action" app:chipIcon="@drawable/source_chip_link" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/cancel_connection" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cancel_connection" android:visibility="gone" app:chipIcon="@drawable/source_chip_cancel" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.Chip android:id="@+id/session_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/not_connected" android:textAppearance="?attr/textAppearanceBodyMedium" style="@style/Widget.SaoSource.Chip.Status" app:chipIcon="@drawable/source_chip_check" app:chipIconVisible="true" android:saveEnabled="false" android:clickable="false" android:focusable="false" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/all_media" android:text="@string/all_media" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_all_inclusive" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/choose_album" style="@style/Widget.SaoSource.Chip.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/choose_album" app:chipIcon="@drawable/source_chip_photo_library" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/album_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/search_heading" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorPrimary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/search_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.Chip android:id="@+id/show_fallback" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/fallback_heading" app:chipIcon="@drawable/source_chip_settings" app:chipIconVisible="true" android:saveEnabled="false" />
        <LinearLayout android:id="@+id/fallback" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fallback_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
                <com.google.android.material.chip.Chip android:id="@+id/import_session" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/import_session" app:chipIcon="@drawable/source_chip_insert_drive_file" app:chipIconVisible="true" android:saveEnabled="false" />
                <com.google.android.material.chip.Chip android:id="@+id/paste_session" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/paste_session" app:chipIcon="@drawable/source_chip_edit" app:chipIconVisible="true" android:saveEnabled="false" />
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/account_index" app:helperText="@string/account_index_help">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/account_index" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" android:maxLength="2" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ready" android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/check_service" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/check_service" app:chipIcon="@drawable/source_chip_link" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/remove_source" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove_source" app:chipIcon="@drawable/source_chip_delete" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/save_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save_source" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
