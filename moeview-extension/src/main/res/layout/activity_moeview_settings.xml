<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/profile_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/source_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1" android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/board" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/board" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/board_yandere" android:text="@string/board_yandere" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_public" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/board_konachan" android:text="@string/board_konachan" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_public" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/board_gelbooru" android:text="@string/board_gelbooru" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_public" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/board_danbooru" android:text="@string/board_danbooru" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_public" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ratings" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/rating" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/rating_safe" android:text="@string/rating_safe" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_shield" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/rating_non_safe" android:text="@string/rating_non_safe" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_shield" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/rating_all" android:text="@string/rating_all" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_all_inclusive" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/base_tags" app:helperText="@string/tags_help">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/base_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="3" android:maxLength="1024" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.Chip android:id="@+id/use_proxy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/use_proxy" style="@style/Widget.SaoSource.Chip.Filter" app:chipIcon="@drawable/source_choice_public" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        <TextView android:id="@+id/proxy_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/proxy_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <LinearLayout android:id="@+id/account_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/account_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/account_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/username">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/account" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:maxLength="128" android:saveEnabled="false" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/api_key" app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/api_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:maxLines="1" android:maxLength="512" android:saveEnabled="false" android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/clear_verification" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_verification" android:visibility="gone" app:chipIcon="@drawable/source_chip_cancel" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/verify_cloudflare" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/verify_cloudflare" app:chipIcon="@drawable/source_chip_shield" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verification_help" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/test_connection" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/test" app:chipIcon="@drawable/source_chip_link" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/delete_source" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete" android:visibility="gone" app:chipIcon="@drawable/source_chip_delete" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/save_connection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
