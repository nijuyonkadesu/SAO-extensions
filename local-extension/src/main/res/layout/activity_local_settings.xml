<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/setup" android:textAppearance="?attr/textAppearanceBodyLarge" />
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/section_profile" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="@string/profile_name">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/source_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.Chip android:id="@+id/nsfw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/nsfw_source" style="@style/Widget.SaoSource.Chip.Filter" app:chipIcon="@drawable/source_choice_shield" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nsfw_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/folders" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/folders_hint" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/import_method" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/import_method" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/picker_folder" android:text="@string/picker_folders_short" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_folder" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/picker_photos" android:text="@string/picker_photos_short" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_photo_library" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/picker_files" android:text="@string/picker_files_short" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_insert_drive_file" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:id="@+id/import_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/cloud_media_settings" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cloud_media_settings" android:visibility="gone" app:chipIcon="@drawable/source_chip_cloud" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <LinearLayout android:id="@+id/folder_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/add_folder" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_folder" app:chipIcon="@drawable/source_chip_add" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/add_whole_folder" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_whole_folder" android:visibility="gone" app:chipIcon="@drawable/source_chip_folder" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <include android:id="@+id/intake" layout="@layout/source_intake_section" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/indexing" />
        <include android:id="@+id/index_status" layout="@layout/index_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/index_help" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/constraints" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/browse_metadata" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/edit_metadata" app:chipIcon="@drawable/source_chip_edit" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/rescan" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rescan" app:chipIcon="@drawable/source_chip_refresh" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/pause_indexing" style="@style/Widget.SaoSource.Chip.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pause" app:chipIcon="@drawable/source_chip_pause" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/context_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/context_help" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/model_choice" android:textAppearance="?attr/textAppearanceLabelLarge" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/model_choice" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/model_immich" android:text="@string/model_immich_short" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_auto_awesome" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/model_lite" android:text="@string/model_lite_short" style="@style/Widget.SaoSource.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipIcon="@drawable/source_choice_auto_awesome" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <TextView android:id="@+id/model_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:id="@+id/model_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.chip.Chip android:id="@+id/choose_model_folder" style="@style/Widget.SaoSource.Chip.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/choose_model_folder" app:chipIcon="@drawable/source_chip_folder" app:chipIconVisible="true" android:saveEnabled="false" />
        <TextView android:id="@+id/model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/model_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:max="1000" app:trackThickness="4dp" app:trackCornerRadius="2dp" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/download_model" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/download_model" app:chipIcon="@drawable/source_chip_download" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/pause_download" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pause_album" app:chipIcon="@drawable/source_chip_pause" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.Chip android:id="@+id/context_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/use_context" style="@style/Widget.SaoSource.Chip.Filter" app:chipIcon="@drawable/source_choice_auto_awesome" app:chipIconVisible="true" android:checkable="true" android:saveEnabled="false" />
        <TextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorError" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/delete_library" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/delete" android:visibility="gone" app:chipIcon="@drawable/source_chip_delete" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/save_library" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/save" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
