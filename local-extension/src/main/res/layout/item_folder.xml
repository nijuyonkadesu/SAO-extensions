<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.Material3.CardView.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/add_media" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_media" android:visibility="gone" app:chipIcon="@drawable/source_chip_add" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <include android:id="@+id/index_status" layout="@layout/index_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/processing_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/pause_folder" style="@style/Widget.SaoSource.Chip.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pause_album" app:chipIcon="@drawable/source_chip_pause" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/restart_folder" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/restart_album" app:chipIcon="@drawable/source_chip_refresh" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/rename" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rename" app:chipIcon="@drawable/source_chip_edit" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/remove" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove" app:chipIcon="@drawable/source_chip_delete" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
